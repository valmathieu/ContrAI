# ─── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[oc]
*.egg-info/

# Build outputs (uv build, hatch, setuptools, ...).
build/
dist/
wheels/

# MkDocs build output.
site/

# ─── Virtual environments ─────────────────────────────────────────────────
.venv/

# ─── Tooling caches ───────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ─── Jupyter ──────────────────────────────────────────────────────────────
# Auto-saved shadows of .ipynb files. Cause noisy diffs and merge conflicts.
.ipynb_checkpoints/

# ─── Engine debug mode ────────────────────────────────────────────────────
# Per-run diagnostics written by `contrai --debug` into the working
# directory. Overwritten on every run - a local artifact, never a repo file.
contrai-debug.log

# ─── Editors / IDEs ───────────────────────────────────────────────────────
.idea/
.vscode/

# ─── OS-generated files ───────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── AI assistants ────────────────────────────────────────────────────────
# The whole Claude Code workspace (settings, skills, worktrees) stays local.
.claude/
CLAUDE.md

# Superpowers planning documents (brainstorm specs, implementation plans) are
# session artifacts, not repo docs - keep them local.
docs/superpowers/
docs/plans/

# One design doc per major feature branch, holding the architectural rationale
# and the feature roadmap. Local by design - they track a branch, not the repo.
*_DESIGN.md

# ─── Scraper / engine local material ──────────────────────────────────────
# The site profile (URL, credentials, selectors, wire vocabulary), the
# pseudonym salt and map, and every game record or raw wire log written by
# `contrai --record` or `contrai-scrape` stay on the machine that made them,
# and so does the fleet's list of spectator accounts.
profile.toml
accounts.toml
*.local.toml
.env
pseudonyms.json
records/
raw/
# Deployment secrets live on the host under /etc/contrai; keep stray copies out.
deploy/*.env
deploy/wireguard/
# Local `--rules` ruleset, kept on the machine that made it.
table.toml
