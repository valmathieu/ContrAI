# Copy to /etc/contrai/contrai.env (root, mode 600). The profile names each of
# these as env:NAME; none of them is ever written into this repository.
CONTRAI_SCRAPER_EMAIL=
CONTRAI_SCRAPER_CODE=
# The home connection's public address, so the egress gate can refuse it. Left
# empty, the profile does not load: the scraper fails closed.
CONTRAI_HOME_IP=
