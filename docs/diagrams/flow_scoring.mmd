---
title: contrai-engine — round scoring pipeline (scoring.score_round → components)
---
flowchart TD
    Start(["score_round(round)"]) --> HasContract{"contract<br/>established?"}

    HasContract -- "no (all passed)" --> Zero["every team → 0<br/>contract_made = None<br/>marks = Mark(0, 0)"]
    Zero --> End(["RoundScore"])

    HasContract -- "yes" --> Points["card points per team (trump-aware)<br/>+10 last-trick bonus → last-trick team<br/>belote counts per team (0-4, by all-trump regime)"]
    Points --> Judge{"contract.is_slam_family()?"}

    %% ---------- Judging made / failed ----------
    Judge -- "Slam / Solo Slam" --> SlamMade["made = contract team won all 8<br/>(Solo Slam: bidder personally all 8)<br/>— a trick predicate, points never consulted"]
    Judge -- "numeric" --> Sweep{"M == 1 AND<br/>contract team won all 8?<br/>(unannounced sweep)"}
    Sweep -- "yes" --> SweepTag["tag GRAND_SLAM (bidder all 8), else SLAM<br/>made = true — a sweep cannot fail"]
    Sweep -- "no" --> NumMade["made = attack_pile + own belote ≥ C"]

    %% ---------- The substitute ----------
    SlamMade --> Subst
    SweepTag --> Subst
    NumMade --> Subst
    Subst["substitute = Slam base (250 / 500)<br/>| un-doubled sweep 250 / 500<br/>| None → count the pile for real"]

    %% ---------- The two §7.2 components ----------
    Subst --> MadeComp
    MadeComp["<b>made-points component</b><br/>made: substitute | 160 flat (M &gt; 1) | share the pile<br/>failed: 160 flat to the defense<br/>(Slam keeps its substitute)"]
    MadeComp --> AnnComp
    AnnComp["<b>announced-points component</b><br/>A = C, to the declarer when made<br/>and to the defense when failed"]

    AnnComp --> Reduce["marked_total: apply §7.3 conventions<br/>and place the multiplier M<br/>default → made + announced × M"]
    Reduce --> Belote

    %% ---------- Shared belote footer ----------
    Belote["belote +20 per pair preserved on every shape<br/>→ each pair's holder team (even the round's loser)"]
    Belote --> End

    %% ---------- Engine-orange palette ----------
    classDef entry fill:#FFD9B3,stroke:#B26A28,stroke-width:2px,color:#5C3A14;
    classDef step fill:#FFEFD9,stroke:#B26A28,stroke-width:1px,color:#5C3A14;
    classDef decision fill:#FFF3E0,stroke:#E89A4F,stroke-width:2px,color:#5C3A14;
    classDef component fill:#E1F0FF,stroke:#2F6FAF,stroke-width:2px,color:#123A61;
    classDef belote fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#5F4B00;

    class Start,End entry;
    class HasContract,Judge,Sweep decision;
    class Zero,Points,SlamMade,SweepTag,NumMade,Subst,Reduce step;
    class MadeComp,AnnComp component;
    class Belote belote;
