---
title: contrai-engine — round scoring pipeline (scoring.score_round → components)
---
flowchart TD
    Start(["score_round(round)"]) --> HasContract{"contract<br/>established?"}

    HasContract -- "no (all passed)" --> Zero["every team → 0<br/>contract_made = None<br/>marks = Mark(0, 0)"]
    Zero --> End(["RoundScore"])

    HasContract -- "yes" --> Points["card points per team (trump-aware)<br/>+10 last-trick bonus → last-trick team<br/>belote counts per team (0-4, by all-trump regime)"]
    Points --> Judge{"contract.is_slam_family()?"}

    %% ---------- Judging made / failed ----------
    Judge -- "Slam / Solo Slam" --> SlamMade["made = contract team won all 8<br/>(Solo Slam: bidder personally all 8)<br/>— a trick predicate, points never consulted"]
    Judge -- "numeric" --> Sweep{"M == 1 AND<br/>contract team won all 8?<br/>(unannounced sweep)"}
    Sweep -- "yes" --> SweepTag["tag GRAND_SLAM (bidder all 8), else SLAM<br/>made = true — a sweep cannot fail"]
    Sweep -- "no" --> NumMade["P_att ≥ C <b>AND</b> P_att &gt; P_def<br/>(the out-score test, iff <i>attack_must_outscore_defense</i>;<br/>a tie is the §7.5 dispute and fails)<br/>P = pile + own belote, the belote counted<br/>iff <i>belote_counts_toward_contract</i>"]

    %% ---------- Belote transfer on a failure ----------
    SlamMade --> Transfer
    SweepTag --> Transfer
    NumMade --> Transfer
    Transfer["failed <b>and</b> <i>belote_lost_when_contract_fails</i><br/>→ the declarer's belote moves to the defense<br/>(one-directional: a defender's is never taken)"]

    %% ---------- The substitute ----------
    Transfer --> Subst
    Subst["substitute = Slam base (250 / 500) — always<br/>| un-doubled sweep 250 / 500, iff <i>unannounced_slam_substitute</i><br/>| None → count the pile for real"]

    %% ---------- The two §7.2 components ----------
    Subst --> MadeComp
    MadeComp["<b>made-points component</b><br/>made: substitute | 160 flat (M &gt; 1) | share the pile<br/>failed: 160 flat to the defense<br/>— a failed Slam keeps its substitute<br/>unless <i>failed_slam_marks_made_points</i> is off"]
    MadeComp --> AnnComp
    AnnComp["<b>announced-points component</b><br/>A = C, to the declarer when made<br/>and to the defense when failed<br/>— <i>any_failure_marks_160</i> flattens A to 160 on a failure,<br/>except where <i>failed_slam_marks_announced_points</i> keeps 250 / 500"]

    AnnComp --> Reduce["marked_total: apply §7.3 conventions<br/>and place the multiplier M<br/>default → made + announced × M"]
    Reduce --> Belote

    %% ---------- Shared belote footer ----------
    Belote["belote +20 per pair preserved on every shape<br/>→ each pair's holder team (even the round's loser)"]
    Belote --> End

