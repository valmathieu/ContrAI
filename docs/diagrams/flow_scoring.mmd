    classDef decision fill:#FFF3E0,stroke:#E89A4F,stroke-width:2px,color:#5C3A14;
    classDef component fill:#E1F0FF,stroke:#2F6FAF,stroke-width:2px,color:#123A61;
    classDef belote fill:#FFF8E1,stroke:#F9A825,stroke-width:2px,color:#5F4B00;

    class Start,End entry;
    class HasContract,Judge,Sweep decision;
    class Zero,Points,SlamMade,SweepTag,NumMade,Transfer,Subst,Reduce step;
    class MadeComp,AnnComp component;
    class Belote belote;
