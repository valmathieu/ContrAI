@startuml seq_scraper
title contrai-scraper — the table loop (cli.run → Shift.run → Recorder.run)

' --- Palette: scraper purple, with contrai-data teal for the record end ---
skinparam shadowing false
skinparam sequence {
    ArrowColor #5E4495
    LifeLineBorderColor #9B7FCC
    LifeLineBackgroundColor #EDE7F6
    ParticipantBorderColor #5E4495
    ParticipantBackgroundColor #EDE7F6
    ParticipantFontColor #311B92
    ActorBorderColor #5E4495
    ActorBackgroundColor #EDE7F6
    ActorFontColor #311B92
    GroupBorderColor #5E4495
    GroupBackgroundColor #F3E5F5
    GroupHeaderFontColor #311B92
    BoxBorderColor #5E4495
    BoxBackgroundColor #F3E5F5
    DividerBorderColor #5E4495
    DividerBackgroundColor #D1C4E9
    DividerFontColor #311B92
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
    FontColor #5F4B00
}

actor "Operator" as U

box "browser half" #F3E5F5
    participant "cli.py" as C <<scraper>>
    participant "Shift\n(shift.py)" as SH <<scraper>>
    participant "Spectator\n(browser.py)" as SP <<scraper>>
    participant "page\n(Chromium)" as PG
end box

box "wire half" #EDE7F6
    participant "socket" as SK
    participant "PlaywrightFrameSource\n+ WireStream" as FS <<scraper>>
    participant "Recorder\n(recorder.py)" as R <<scraper>>
    participant "RawLogWriter" as RL <<scraper>>
end box

box "record half" #E0F5F2
    participant "parse_session" as PS <<scraper>> #EDE7F6
    participant "RecordWriter" as RW <<from contrai-data>> #E0F5F2
end box

' The two flags are escaped: a paired ""--"" in Creole prose is strikethrough.
U -> C : contrai-scrape run ~--profile P ~--headless
activate C

C -> SH : Shift(profile, health, egress).run()
activate SH

== 0. Shift gates ==

SH -> SH : schedule.is_active(now)
SH -> SH : egress.check()
note right of SH
  Outside the window no browser is open.
  The echo service is asked before the site's name
  is resolved; the home address is never logged.
end note

SH -> SP : open_spectator(profile, health)\nthat is, open_browser then open_session
note right of SH
  The frame source is attached
  //before// navigation: the first
  socket opens during the walk,
  and the join snapshot rides it.
end note
SP -> PG : a new context, add_init_script(INIT_SCRIPT)\nbefore its page exists
SP -> PG : goto(""[site].url""), log_in()
SP -> PG : enter_variant()
note right of SP
  There is no table list.
  The server chooses where
  the spectator sits.
end note
PG -> SK : <<opens>> two connections

SH -> R : Recorder(..., egress).run()
activate R

== 1. Seat ==

R -> R : reset the buffer and the ""WireStream""
SK -> FS : frames
FS -> R : join snapshot (within ""snapshot_timeout_s"")
R -> RL : write_frame(frame)
note right of R
  A snapshot already used to judge
  a table is remembered, so the
  mirrored copy cannot seat the
  table that was just left.
end note

== 2 to 5. The gates ==

alt not a tournament, or already ""hop_after_rows"" rounds old
    R -> SP : next_table()
    SP -> PG : click the table control
else the wire says yes
    R -> SP : read_options(profile.rules.options)
    SP -> PG : read the options panel
    PG --> SP : one row per option
    SP --> R : OptionsReading
    alt the table plays another ruleset
        R -> SP : next_table()
    else
        R -> SP : read_scoreboard()
        SP -> PG : open, read, close the score panel
        SP --> R : ScoreboardReading
        R -> RL : write_panel("scoreboard", text)
        alt the panel's //us// is not the south seat's side
            R -> SP : next_table()
            note right of R
              A record with the two sides swapped
              is well formed and wrong about who
              won every round.
            end note
        else accepted
            R -> R : buffer = [the snapshot], tables_seated += 1
        end
    end
end

== 6. Watch ==

loop until the game ends, the table goes quiet, or the limits stop it
    SK -> FS : frame
    FS -> R : WireEvent (mirrored copies dropped)
    R -> RL : write_frame(frame)
    R -> R : buffer.append(event); last_event_id = event.frame_id

    alt a deal opens a new round
        R -> SP : request_state(table_id, last_event_id)
        SP -> PG : evaluate(SEND_SCRIPT, envelope)
        PG -> SK : resume frame carrying the last event id
        SK --> FS : a fresh join snapshot
        note right of R
          The answer arrives on the socket
          and lands in the same buffer the
          parser already walks.
        end note
    end
end

== 7. Write, then hop ==

R -> SP : one final request_state, and wait for its snapshot
R -> R : split_visits(buffer) · more than one game or table: record_refused, nothing written
R -> PS : parse_session(order_events(buffer), profile, end_reason)
activate PS
PS --> R : SessionResult(events, notes, skipped_rounds)
deactivate PS
R -> RW : write every event
RW -> RW : ""<root>/games/<game_id>.jsonl""
R -> R : egress.check() — refused: stop, no hop
R -> SP : next_table()
note over R, RW
  The watchdog states ""abandoned"" and an interrupt states
  ""interrupted"": neither is visible to the wire, and the
  flags left on it would describe a different ending.
end note

SH <-- R : SessionSummary(stop_reason)
deactivate R
deactivate SH
C --> U : sessions, games recorded, tables seated, tables rejected
deactivate C

@enduml
