@startuml seq_scraper
title contrai-scraper — spectator observation flow (cli.scrape, current state)

' --- Palette: scraper purple, with grey "future" components ---
skinparam shadowing false
skinparam sequence {
    ArrowColor #5E4495
    LifeLineBorderColor #9B7FCC
    LifeLineBackgroundColor #EDE7F6
    ParticipantBorderColor #5E4495
    ParticipantBackgroundColor #EDE7F6
    ParticipantFontColor #311B92
    ActorBorderColor #5E4495
    ActorBackgroundColor #EDE7F6
    ActorFontColor #311B92
    GroupBorderColor #5E4495
    GroupBackgroundColor #F3E5F5
    GroupHeaderFontColor #311B92
    BoxBorderColor #5E4495
    BoxBackgroundColor #F3E5F5
    DividerBorderColor #5E4495
    DividerBackgroundColor #D1C4E9
    DividerFontColor #311B92
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
    FontColor #5F4B00
}

actor "User" as U
participant "cli.py" as C <<scraper>>
participant "session.py" as SE <<scraper>>
participant "observer.py" as O <<scraper>>
participant "async_playwright" as P <<scraper>>
participant "Browser / page\n(Chromium)" as B
participant "DOM\nspectator site" as D
participant "SQLite" as S <<future>> #DDDDDD

U -> C : contrai-scrape
activate C

C -> P : async_playwright().start()
C -> P : chromium.launch(headless=False, slow_mo=500)
P -> B : <<creates>> page

== Phase 1 — Login flow ==

C -> SE : log_in(page)
activate SE

SE -> B : page.goto(TARGET_URL)
B -> D : navigate
SE -> SE : page.wait_for_timeout(5000)
SE -> B : tutorial_btn.is_visible() ?\n(""gui.quick-start.launch.no"")
alt tutorial visible
    SE -> B : click ""gui.quick-start.launch.no""
end

SE -> B : click ""button:has-text('Email')""
note right of SE
  Fallback selector if the
  primary ""has-text('Email')"" fails:
  ""button[data-icon='email']""
end note
SE -> B : fill ACCOUNT_EMAIL into\n""input[placeholder='Adresse électronique']""
SE -> B : click ""gui.users.email-wizard.continue""
SE -> B : wait_for_selector(""#verificationCode"")
SE -> B : fill ""#verificationCode"" ← VERIFICATION_CODE
SE -> B : click ""#validateBtn""
B --> D : authenticate
SE -> SE : page.wait_for_timeout(10000)
deactivate SE

== Phase 2 — Mode navigation ==

C -> SE : open_spectator_mode(page)
activate SE
SE -> B : click ""gui.actions.mode.online""
SE -> B : click ""gui.actions.online.observe""
SE -> B : click ""gui.versions.contree""
deactivate SE

== Phase 3 — Table discovery ==

C -> SE : find_tournament_table(page)
activate SE
SE -> B : ""'.table-list-item'"".first.click()  (timeout 3s)
note right of SE
  If auto-join times out,
  user has 5s to click a
  table manually.
end note

loop up to MAX_TABLE_ATTEMPTS (20)
    SE -> SE : page.wait_for_timeout(2000)
    SE -> B : ""#tournamentMatchInfo"".is_visible() ?
    alt tournament match found
        SE --> C : True
    else standard table
        SE -> B : click ""gui.online.tables.other-table""
        SE -> SE : page.wait_for_timeout(3000)
    end
end
deactivate SE

== Phase 4 — Observation ==

C -> O : observe_game(page)
activate O

O -> B : get_players(page)
loop seat ∈ {nord, sud, est, ouest}
    O -> D : inner_text(""#{seat} div[data-role='badge']"")
    D --> O : player name
end

O -> O : is_game_scrapeable(players)
note right of O
  **<<future>>** — currently
  returns **True** always.
  Will check a DB whether
  these players are already
  being scraped.
end note

O -> B : last_known_round = get_current_round(page)
B -> D : inner_text(""#tour label[data-i18n='gui.scores.tour']"")
D --> O : "TOUR N" → regex \d+ → int

loop forever (1s poll)
    O -> B : current_round = get_current_round(page)
    alt round changed (and ≠ UNKNOWN_ROUND)
        O -> O : print "🎬 ROUND N STARTED - RECORDING"

        ' --- FUTURE LOGIC block inside observer.observe_game ---
        group <<future>> FUTURE LOGIC — observer.observe_game
            O -->> B : observe_bidding(page)
            O -->> B : observe_gameplay(page)
            O -->> S : persist round / bids / plays
        end

        O -> O : last_known_round = current_round
    end
    O -> O : page.wait_for_timeout(1000)
end
deactivate O

== Shutdown ==

' The observation loop never returns today, so this branch is only
' reached when no tournament table was found in Phase 3.
C -> B : browser.close()
deactivate C

note over C, S
  **What is NOT wired up yet**
  • ""observe_bidding(page)"" and ""observe_gameplay(page)"" — commented placeholders
  • Any persistence path — no SQLite (or other) writes
  • DB-based de-duplication of already-scraped players
end note

@enduml
