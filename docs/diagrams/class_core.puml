@startuml class_core
title contrai-core — domain model (current state)

' --- Palette: core blue ---
skinparam shadowing false
skinparam class {
    BackgroundColor #E1F0FF
    BorderColor #3D6FA5
    HeaderBackgroundColor #7AAEE3
    FontColor #0D3B66
    AttributeFontColor #0D3B66
    StereotypeFontColor #1A5490
}
skinparam enum {
    BackgroundColor #E1F0FF
    BorderColor #3D6FA5
    HeaderBackgroundColor #7AAEE3
    FontColor #0D3B66
    StereotypeFontColor #1A5490
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
    FontColor #5F4B00
}
skinparam ArrowColor #3D6FA5

' =========================================================
' Enums + module-level constants (types.py)
' =========================================================
package "types.py" as p_types {
    enum Suit <<enum>> {
        SPADES    = "Spades"
        HEARTS    = "Hearts"
        DIAMONDS  = "Diamonds"
        CLUBS     = "Clubs"
        --
        + ~__str~__() : str
    }

    ' ALL_TRUMP is declared but unwired: PlantUML cannot grey a single
    ' member line (HTML colour tags are ignored inside an enum body), so
    ' the <<future>> stereotype plus the note below carry that status.
    enum TrumpVariant <<enum>> {
        NO_TRUMP  = "NoTrump"
        ALL_TRUMP = "AllTrump" <<future — unbookable, raises>>
        --
        + ~__str~__() : str
    }

    enum Rank <<enum>> {
        SEVEN, EIGHT, NINE, TEN
        JACK, QUEEN, KING, ACE
    }

    class "ContractSuit" as p_contractsuit <<type alias>> {
        Suit | TrumpVariant
        --
        + {static} CONTRACT_SUITS : tuple<ContractSuit>
        --
        + is_trump(card_suit: Suit,\n  contract_suit: ContractSuit?) : bool
        + trump_suits(contract_suit: ContractSuit?)\n  : tuple<Suit>
    }

    note bottom of Suit
      Exactly the four card-bearing suits, so
      ""tuple(Suit)"" is safe wherever a real card
      suit is meant —— the deck, the display order,
      the AI's suit search, the fallen/void maps.
      Definition order IS the suit preference.
    end note

    note bottom of p_contractsuit
      **The only place the two suit types meet.**
      ""is_trump"" replaces the ""card.suit == trump_suit""
      that used to be written out at every boundary:
      that comparison is right for ""NO_TRUMP"" only by
      accident (no card carries it, so trump branches
      collapse to follow-suit) and answered the same
      for ""ALL_TRUMP"", which silently played an
      all-trump round as a no-trump one.
      ""is_trump"" raises ""NotImplementedError"" there.
      ""trump_suits"" is the enumerating sibling, for
      callers asking //is anything trump at all//.
      ----
      Plain ""Suit | TrumpVariant"" assignment, **not**
      a PEP 695 ""type"" alias. ""isinstance(x, ContractSuit)""
      works on the plain form and raises ""TypeError"" on
      the alias form. No type checker is configured here,
      so ""isinstance"" narrowing is the only guardrail
      there is.
    end note
}

' =========================================================
' Seats (position.py)
' =========================================================
package "position.py" as p_position {
    enum Position <<enum>> {
        NORTH = "North"
        WEST  = "West"
        SOUTH = "South"
        EAST  = "East"
        --
        + next : Position                   <<property>>
        + partner : Position                <<property>>
        + opponents : tuple<Position,Position> <<property>>
        + french_name : str                 <<property>>
        --
        + {static} from_french(name: str) : Position
        + __str__() : str
    }

    note bottom of Position
      The four table seats as a strict enum.
      Definition order **is** the anticlockwise
      turn order (N → W → S → E), so
      ""list(Position)"" is the canonical
      seating and ""next"" / ""partner"" /
      ""opponents"" all derive from that one
      ordering instead of each re-encoding
      seat arithmetic.
      Deliberately a plain Enum, **not** a
      StrEnum: a Position member never compares
      equal to a bare seat string, so a stray
      string comparison can never silently pass.
      ""french_name"" / ""from_french"" map to
      the scraper's DOM ids (nord / ouest /
      sud / est) via the module-level
      ""~_TO~_FRENCH"" / ""~_FROM~_FRENCH""
      tables — kept outside the class body
      because Enum would turn a class-level
      dict into a fifth member.
    end note
}

' =========================================================
' Card & deck (card.py, deck.py)
' =========================================================
package "card.py / deck.py" as p_card {
    class Card <<frozen dataclass>> {
        + suit : Suit <<a real card suit only>>
        + rank : Rank
        --
        + {static} NORMAL_POINTS : dict<Rank, int>
        + {static} TRUMP_POINTS  : dict<Rank, int>
        + {static} NORMAL_ORDER  : dict<Rank, int>
        + {static} TRUMP_ORDER   : dict<Rank, int>
        + {static} SUIT_SYMBOLS  : dict<Suit, str>
        --
        + ~__post_init~__() : None <<rejects a non-Suit>>
        + is_trump(trump_suit: ContractSuit? = None) : bool
        + get_points(trump_suit: ContractSuit? = None) : int
        + get_order(trump_suit: ContractSuit? = None)  : int
        + __str__() : str
    }

    note bottom of Card
      Immutable value object: equality and
      hashing are by ""(suit, rank)"", so
      distinct instances of the same physical
      card are equal and hashable. No
      ""~__lt~__"" — strength is parametric via
      ""get_order(trump_suit)"", and the four
      class-level tables above are the single
      source of truth for points and ordering
      (trump vs plain).
    end note

    class Deck {
        + cards : list<Card>
        --
        + shuffle() : None
        + cut() : None
        + deal(players: list) : None
        + is_empty() : bool
        + add_cards(cards: list<Card>) : None
    }
}

' =========================================================
' Hand (hand.py)
' =========================================================
package "hand.py" as p_hand {
    class Hand {
        + cards : list<Card>
        --
        + __init__(cards: Iterable<Card>? = None)
        .. list-compatible API ..
        + append(card: Card) : None
        + extend(cards: Iterable<Card>) : None
        + remove(card: Card) : None
        + clear() : None
        + copy() : list<Card>
        + __contains__(card) : bool
        + __iter__() : Iterator<Card>
        + __len__() : int
        + __getitem__(idx) : Card | list<Card>
        .. query helpers ..
        + count_suit(suit: Suit) : int
        + count_rank(rank: Rank) : int
        + has_suit(suit: Suit) : bool
        + has_card(suit: Suit, rank: Rank) : bool
        + cards_of_suit(suit: Suit) : list<Card>
        + is_complete() : bool
    }

    note bottom of Hand
      Wraps a ""list[Card]"" and forwards the
      list operations the engine relies on, so
      call sites can keep treating a hand like
      a list. ""copy()"" returns a plain
      ""list[Card]"", not another Hand.
      No size invariant is enforced anywhere —
      ""is_complete()"" is the opt-in check for
      a fully dealt 8-card hand.
    end note
}

' =========================================================
' Team & BasePlayer (team.py, player.py)
' =========================================================
package "team.py / player.py" as p_team {
    class Team {
        + name : str
        + players : list<BasePlayer>
        + total_score : int
        --
        + __init__(name: str, players: list<BasePlayer>)
        + add_points(points: int) : None
        + get_partner(player: BasePlayer) : BasePlayer?
        + contains_player(player: BasePlayer) : bool
    }

    class BasePlayer {
        + name : str
        + position : Position
        + hand : Hand
        + team : Team?
        --
        + __init__(name: str, position: Position)
    }

    note bottom of BasePlayer
      Identity and table state only — pure
      data. The decision hooks
      (""choose_bid"" / ""choose_card"") live
      on the engine-side subclasses.
    end note
}

' =========================================================
' Bid hierarchy (bid.py) — frozen dataclass sum type
' =========================================================
package "bid.py" as p_bid {
    class Bid <<frozen dataclass>> {
        + player : BasePlayer <<compare=False>>
    }

    class PassBid <<frozen dataclass>> {
        + __str__() : str <<"Pass">>
    }

    enum SlamLevel {
        SLAM      = (250, "Slam")
        SOLO_SLAM = (500, "Solo Slam")
        --
        + base_value : int <<250 / 500>>
        + label : str
        + __str__() : str <<the label>>
    }

    class ContractBid <<frozen dataclass>> {
        + {static} VALID_VALUES = [80..180, SlamLevel.SLAM, SlamLevel.SOLO_SLAM]
        + {static} VALID_SUITS = CONTRACT_SUITS - ALL_TRUMP
        + value : int | SlamLevel
        + suit : ContractSuit
        --
        + ~__post_init~__() : None <<rejects ALL_TRUMP by name>>
        + get_numeric_value() : int <<SlamLevel → base_value>>
        + __gt__(other) : bool <<strict numeric ordering>>
        + __str__() : str
    }

    class DoubleBid <<frozen dataclass>> {
        + __str__() : str <<"Double">>
    }

    class RedoubleBid <<frozen dataclass>> {
        + __str__() : str <<"Redouble">>
    }

    note bottom of Bid
      Pure value carriers — no auction-state
      behaviour. ""player"" is excluded from
      ""~__eq~__"" and ""~__hash~__"" (matching
      bid equality on //what was announced//,
      not who announced it). All four
      variants are frozen, slotted dataclasses.
      ""SlamLevel"" owns the 250 / 500 base
      values as data, so nothing downstream
      re-derives them from a string.
    end note
}

' =========================================================
' Auction (auction.py) — bidding-state rule oracle
' =========================================================
package "auction.py" as p_auction {
    class Auction <<frozen dataclass>> {
        + bids : tuple<Bid> = ()
        --
        + {static} empty() : Auction
        + is_legal(bid: Bid) : bool
        + legal_actions(player: BasePlayer) : tuple<Bid>
        + apply(bid: Bid) : Auction <<raises IllegalBidError>>
        + is_terminal() : bool
        + contract() : Contract?
        --
        + last_contract_bid : ContractBid? <<property>>
        + has_double : bool             <<property>>
        + has_redouble : bool           <<property>>
        + double_player : BasePlayer?   <<property>>
        + redouble_player : BasePlayer? <<property>>
        + consecutive_passes : int      <<property>>
        + partner_bid(player) : Bid?
    }

    note bottom of Auction
      Immutable bidding-phase state.
      Owns the chronological bid history
      and the contrée rules (see
      ""contree-domain.md §5.2"" and §5.3):
      value precedence, the Double / Redouble
      freeze, and the Slam-blocks-Solo-Slam
      asymmetry.
      Bids themselves stay dumb value
      carriers: every legality question is
      answered here, by ""is_legal"" /
      ""legal_actions"", and ""apply"" raises
      ""IllegalBidError"" rather than silently
      downgrading an illegal bid to a Pass.
      The shape (""legal_actions"" +
      ""apply"") mirrors MCTS / RL game-state
      interfaces, so the auction phase is
      ready to drop into a future
      imperfect-information state object.
    end note
}

' =========================================================
' Contract & Trick (contract.py, trick.py)
' =========================================================
package "contract.py / trick.py" as p_contract {
    class Contract {
        + contract_bid : ContractBid
        + player : BasePlayer
        + team : Team
        + value : int | SlamLevel
        + suit : ContractSuit
        + double_player : BasePlayer?   <<who called Coinche>>
        + redouble_player : BasePlayer? <<who called Surcoinche>>
        --
        + double : bool    <<property>>
        + redouble : bool  <<property>>
        --
        + __init__(contract_bid, double_player=None, redouble_player=None)
        + get_multiplier() : int <<1, 2, or 4>>
        + is_slam() : bool
        + is_solo_slam() : bool
        + is_slam_family() : bool
        + get_base_points() : int <<Slam → 250, Solo Slam → 500>>
        + get_slam_card_substitute() : int <<250 / 500, else 0>>
        + __str__() : str
        + __eq__(other) : bool
    }

    note bottom of Contract
      The doubled / redoubled state is
      **derived**, not stored: ""double"" and
      ""redouble"" are properties reading
      ""double_player"" / ""redouble_player"",
      so an "anonymous double" is
      unrepresentable and there is no boolean
      flag to keep in sync. The constructor
      rejects a redouble without a double.
      ""~__eq~__"" is defined without
      ""~__hash~__"", so a Contract — and
      anything holding one, e.g. PlayState —
      is unhashable by design.
    end note

    class Trick {
        + plays : list<(BasePlayer, Card)>
        --
        + __init__()
        + add_play(player: BasePlayer, card: Card) : None
        + get_cards() : list<Card>
        + get_led_suit() : Suit?
        + get_plays() : list<(BasePlayer, Card)>
        + get_current_winner(trump_suit: ContractSuit?) : BasePlayer?
        + is_complete() : bool
        + __len__() : int
    }

    class "trick.py" as p_trick_fn <<module>> {
        current_winner(plays, trump_suit) : PlayerT? <<generic over the plays' "who" slot>>
    }

    note bottom of Trick
      A dumb container of plays — it does **not**
      store trump. ""get_current_winner(trump_suit)""
      takes trump as a **required** argument
      (like ""Card.get_order"" / ""get_points"") and
      works on **partial** tricks. The engine
      builds ""Trick()"" bare and passes the
      contract's suit for trick-winner
      determination, the partner-master legality
      check, and the view's live winner highlight.
      The winner rule itself is the module-level
      ""current_winner(plays, trump_suit)""
      function — ""get_current_winner"" delegates
      to it and ""PlayState"" (play.py) calls it
      directly — one implementation, not two
      that could drift.
    end note
}

' =========================================================
' Play phase (play.py) — the play-phase rule oracle,
' Auction's sibling for card play
' =========================================================
package "play.py" as p_play {
    class Play <<namedtuple>> {
        + player : BasePlayer
        + card : Card
    }

    class ObservedPlay <<namedtuple>> {
        + position : Position
        + card : Card
    }

    class PlayState <<frozen dataclass>> {
        + contract : Contract
        + players : tuple<BasePlayer>
        + hands : tuple<tuple<Card>>
        + plays : tuple<Play> = ()
        --
        + {static} start(contract, players, hands) : PlayState
        + hand_of(player: BasePlayer) : tuple<Card>
        + legal_actions(player: BasePlayer) : tuple<Card>
        + apply(play: Play) : PlayState <<raises IllegalPlayError>>
        + with_hands(hands: tuple<tuple<Card>>) : PlayState
        + observe(player, bids=()) : PlayObservation
        + is_terminal() : bool
        --
        + trick_number : int                    <<property>>
        + current_trick : tuple<Play>            <<property>>
        + completed_tricks : tuple<tuple<Play>>  <<property>>
        + trick_winners : tuple<BasePlayer>      <<property>>
        + to_act : BasePlayer?                   <<property>>
    }

    class PlayObservation <<frozen dataclass>> {
        + player : BasePlayer
        + hand : tuple<Card>
        + contract : Contract
        + bids : tuple<Bid>
        + completed_tricks : tuple<tuple<ObservedPlay>>
        + current_trick : tuple<ObservedPlay>
        + legal_cards : tuple<Card>
        --
        + trick_number : int            <<property>>
        + trump_suit : ContractSuit?    <<property>>
        + led_suit : Suit?              <<property>>
        + played_cards : tuple<Card>    <<property>>
        + current_winner : Position?    <<property>>
    }

    note bottom of PlayState
      Auction's sibling for the play phase. Bare
      constructor performs no validation (tests /
      search forks inject arbitrary mid-round
      states directly); start() validates a fresh
      deal (4 players, 4×8 cards, 32 distinct).
      Per-seat state is parallel tuples (players
      alongside hands), not a player-keyed map —
      BasePlayer hashing is identity-based.
      Derived views (trick_number, current_trick,
      completed_tricks, trick_winners, to_act,
      is_terminal()) recompute from plays on every
      access — slots=True forbids caching them.
      legal_actions(player) enforces only the
      follow/trump obligations, deliberately no
      turn check — mirroring Auction.legal_actions.
      apply(play) is the single legality-enforcing
      transition; turn order is checked there.
      with_hands() forks the public history onto
      replacement hands — the determinization
      primitive a future search-based AI would
      sample from; no search runs on it yet.
    end note

    note bottom of PlayObservation
      The imperfect-information projection
      PlayState.observe(player, bids) builds: own
      hand + public trick history + own legal
      cards, never another seat's hand. The trick
      records are sealed ""ObservedPlay""
      ""(position, card)"" pairs — no live
      ""BasePlayer"" (so no hand) is reachable
      through them. ""contract"" / ""bids"" still
      name the players who bid; sealing those too
      is deferred to the AI-training work.
    end note
}

' =========================================================
' Exceptions (exceptions.py)
' =========================================================
package "exceptions.py" as p_exc {
    class "Exception" as Exception <<stdlib>> #EEEEEE
    class "ValueError" as ValueError <<stdlib>> #EEEEEE

    class ContraiError <<base>>

    enum PlayRuleViolation <<StrEnum>> {
        MUST_FOLLOW_SUIT
        MUST_TRUMP
        MUST_OVERTRUMP
        OUT_OF_TURN
        CARD_NOT_IN_HAND
    }

    class InvalidPlayerCountError {
        + expected_count : int
        + actual_count   : int
        + context : str
    }

    class InvalidCardCountError {
        + expected_count : int
        + actual_count   : int
        + context : str
    }

    class InvalidCardError {
        + context : str
    }

    class IllegalBidError {
        + bid : Bid
        + bids : tuple<Bid>
        + context : str
    }

    class IllegalPlayError {
        + card : Card
        + reason : PlayRuleViolation
        + legal_cards : tuple<Card>
        + context : str
    }

    class TrickStateError {
        + context : str
    }

    class InvalidContractError {
        + context : str
    }

    ' Every domain error dual-inherits (ContraiError, ValueError);
    ' ValueError stays in the MRO so an except-ValueError handler
    ' keeps catching the whole family.
    ContraiError            --|> Exception
    InvalidPlayerCountError --|> ContraiError
    InvalidPlayerCountError --|> ValueError
    InvalidCardCountError   --|> ContraiError
    InvalidCardCountError   --|> ValueError
    InvalidCardError        --|> ContraiError
    InvalidCardError        --|> ValueError
    IllegalBidError         --|> ContraiError
    IllegalBidError         --|> ValueError
    IllegalPlayError        --|> ContraiError
    IllegalPlayError        --|> ValueError
    TrickStateError         --|> ContraiError
    TrickStateError         --|> ValueError
    InvalidContractError    --|> ContraiError
    InvalidContractError    --|> ValueError
    IllegalPlayError        --> PlayRuleViolation : reason
}

' =========================================================
' Relationships
' =========================================================

' Inheritance — Bid hierarchy
Bid <|-- PassBid
Bid <|-- ContractBid
Bid <|-- DoubleBid
Bid <|-- RedoubleBid

' The ContractSuit union is made of the two enums
p_contractsuit ..> Suit          : <<union member>>
p_contractsuit ..> TrumpVariant  : <<union member>>

' Card composes enums (by-reference). Card.suit is a Suit and never a
' TrumpVariant — __post_init__ enforces it.
Card --> Suit
Card --> Rank
Card ..> p_contractsuit          : is_trump / get_order(trump_suit)
Card ..> InvalidCardError        : <<raises on a non-Suit suit>>

' Hand owns Cards
Hand "1" *-- "0..8" Card : cards

' Deck owns the full 32-card set
Deck "1" *-- "32" Card : cards

' Player owns its Hand, references Team, is seated at a Position
BasePlayer "1" *-- "1" Hand : hand
BasePlayer "1" o-- "0..1" Team : team
BasePlayer --> Position : position

' Team aggregates exactly 2 players
Team "1" o-- "2" BasePlayer : players

' Bid references BasePlayer
Bid "1" o-- "1" BasePlayer : player
ContractBid --> p_contractsuit : suit
ContractBid ..> SlamLevel : value (all-tricks bids)

' Auction composes a tuple of Bids and materialises a Contract
Auction "1" *-- "0..N" Bid       : bids
Auction ..> Contract             : <<materialises>>
Auction ..> IllegalBidError      : <<raises on apply>>

' Contract references ContractBid + BasePlayer + Team
Contract "1" o-- "1" ContractBid : contract_bid
Contract "1" o-- "1" BasePlayer  : player
Contract "1" o-- "1" Team        : team
Contract --> p_contractsuit      : suit

' Trick composes (player, card) plays; trump arrives via get_current_winner
Trick "1" *-- "0..4" Card        : (via plays)
Trick "1" o-- "0..4" BasePlayer  : (via plays)
Trick ..> p_contractsuit         : get_current_winner(trump_suit)
Trick ..> p_trick_fn             : <<delegates>>

' Play is a (player, card) pair — same ownership split as Trick's plays
Play "1" o-- "1" BasePlayer : player
Play "1" *-- "1" Card       : card

' ObservedPlay is the sealed observation-facing record: the seat's
' Position replaces the live BasePlayer, so no hand crosses observe()
ObservedPlay --> Position   : position
ObservedPlay "1" *-- "1" Card : card
PlayObservation "1" *-- "0..32" ObservedPlay : completed_tricks / current_trick

' PlayState references the established contract + seated players,
' composes the flat play history, and holds per-seat remaining hands
PlayState "1" o-- "1" Contract    : contract
PlayState "1" o-- "4" BasePlayer  : players
PlayState "1" *-- "0..32" Card    : hands
PlayState "1" *-- "0..32" Play    : plays
PlayState ..> PlayObservation     : <<observe>>
PlayState ..> p_trick_fn          : <<winner rule>>

' Operations raising exceptions
Team ..> InvalidPlayerCountError : <<raises>>
Deck ..> InvalidPlayerCountError : <<raises>>
Deck ..> InvalidCardCountError   : <<raises>>
ContractBid ..> InvalidContractError : <<raises in post-init>>
Contract ..> InvalidContractError    : <<redouble w/o double>>
Trick ..> TrickStateError            : <<raises on add_play>>
PlayState ..> IllegalPlayError       : <<raises on apply>>

@enduml
