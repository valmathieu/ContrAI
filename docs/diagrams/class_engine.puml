@startuml class_engine
title contrai-engine — model + view + cli (current state, honest portrayal)

' --- Palette: engine orange (own types), core blue (boundary types) ---
skinparam shadowing false
skinparam class {
    BackgroundColor #FFEFD9
    BorderColor #B26A28
    HeaderBackgroundColor #E89A4F
    FontColor #5C3A14
    AttributeFontColor #5C3A14
    StereotypeFontColor #8A4F1C
}
skinparam note {
    BackgroundColor #FFFDE7
    BorderColor #F9A825
    FontColor #5F4B00
}
skinparam ArrowColor #B26A28

' =========================================================
' Boundary elements from contrai-core (blue palette).
' Declared explicitly so the association targets below do
' not get auto-created in the engine's orange.
' =========================================================
class BasePlayer <<from contrai-core>> #E1F0FF {
    + name : str
    + position : Position
    + hand : Hand
    + team : Team?
}

class Position  <<from contrai-core>> #E1F0FF
enum TeamSide   <<from contrai-core>> #E1F0FF
class Team      <<from contrai-core>> #E1F0FF
class Deck      <<from contrai-core>> #E1F0FF
class Contract  <<from contrai-core>> #E1F0FF
class Auction   <<from contrai-core>> #E1F0FF {
    + rules : RuleConfig
}
class PlayState <<from contrai-core>> #E1F0FF
class RuleConfig <<from contrai-core>> #E1F0FF
enum Suit       <<from contrai-core>> #E1F0FF
class "ContractSuit" as p_contractsuit <<from contrai-core>> #E1F0FF

' =========================================================
' model/player/ — Player hierarchy + pluggable AI strategies
' =========================================================
package "model/player/ (subpackage)" as p_player {

    ' --- base.py: Player hierarchy ---
    abstract class Player <<abstract>> {
        + is_human : bool <<property>>
        --
        + {abstract} choose_bid(auction: Auction) : Bid?
        + {abstract} choose_card(observation: PlayObservation) : Card?
    }

    class HumanPlayer {
        + choose_bid(auction) : None  <<no-op>>
        + choose_card(observation) : None  <<no-op>>
    }

    ' --- ai.py: holds + delegates to strategies ---
    class AiPlayer {
        + bidding : BiddingStrategy
        + cardplay : CardPlayStrategy
        --
        + __init__(name, position: Position, bidding=…, cardplay=…)
        + choose_bid(auction) : Bid       <<delegates>>
        + choose_card(observation) : Card  <<delegates>>
    }

    ' --- strategy.py: shared player access + abstract interfaces ---
    class PlayerStateMixin <<mixin>> {
        - _player : AiPlayer
        --
        + __init__(player)
        + hand : Hand         <<property>>
        + team : Team?        <<property>>
        + position : Position <<property>>
    }

    abstract class BiddingStrategy <<abstract>> {
        + {abstract} choose_bid(auction: Auction) : Bid
    }
    abstract class CardPlayStrategy <<abstract>> {
        + {abstract} choose_card(observation: PlayObservation) : Card
    }

    ' --- rule_based/ : the first concrete level (expert) ---
    class RuleBasedBiddingStrategy {
        + {static} BIDDING_TABLE : list<tuple>
        + {static} SUIT_PREFERENCE : tuple<Suit> <<= tuple(Suit)>>
        + {static} SLAM_NUMERIC : int
        + {static} SOLO_SLAM_NUMERIC : int
        --
        + choose_bid(auction) : Bid
        - _choose_under_double(auction) : Bid
        - _choose_open_bid(auction) : Bid
    }
    class RuleBasedCardPlayStrategy {
        + choose_card(observation) : Card
        - _derive_tracking(observation) : (fallen, voids)
        - _is_master_card(card, trump_suit, fallen) : bool
    }

    ' --- levels.py: registry + factory ---
    class "levels.py" as p_levels <<module>> #FFEFD9 {
        AI_LEVELS : dict<str, (Bidding, CardPlay)>
        make_ai_player(name, position: Position, level="expert") : AiPlayer
    }

    note right of AiPlayer
      ""AiPlayer"" owns no strategy logic. It
      holds an injected ""bidding"" and
      ""cardplay"" strategy and delegates to
      them. Strategies are passed as factories
      (""player -> strategy"") so each can take
      a back-reference to the player while the
      player is still being built — that
      back-reference is what
      ""PlayerStateMixin"" reads through.
      Defaults reproduce today's expert bot.
    end note

    note bottom of RuleBasedBiddingStrategy
      First concrete level, in
      ""rule_based/bidding.py""
      (""AI_LEVELS["expert"]"").
      ""choose_bid"" resolves the Double/Redouble
      freeze via ""_choose_under_double"", then
      ""_choose_open_bid"" walks ""auction.bids""
      directly, resolves the hand once to a single
      (contract, suit) pair via ""_find_best_contract""
      (belote first, then preference-order tie-break)
      and returns a typed Bid (PassBid / ContractBid /
      DoubleBid) — no wire format.
      ~15 collapsed strategy helpers (_evaluate_suits,
      _evaluate_suit_as_trump, _estimate_tricks,
      _find_best_contract, _make_initial_bid,
      _support_partner_bid, _check_double, …).
      **BIDDING_TABLE** rows (11 levels: 80–160 + Slam
      + Solo Slam): (contract, trump_req, trump_min,
      aces, tricks_min, belote_required).
    end note

    note bottom of RuleBasedCardPlayStrategy
      First concrete card-play level, in
      ""rule_based/card_play.py"". Stateless
      between calls — every decision is a pure
      function of the frozen PlayObservation handed
      in. ""_derive_tracking"" rebuilds the fallen-
      card map and the trump-void set by replaying
      the observation's public trick history each
      turn (compelled-only void inference: a discard
      behind a master partner proves nothing; a
      trump lead's proof is unconditional). ~15
      collapsed helpers (_play_opening/leading/
      following_card, _play_when_team_winning/losing,
      _is_master_card, _is_stronger_card,
      _can_trump_win, _opponents_might_have_trump,
      _opponent_cut_expected, …). Every trump / point /
      ranking question resolves through core
      ""rules_for(trump_suit)"" — no local ladders.
      Partner / opponent seats come from
      ""Position.partner"", not a local seat map,
      and "did my side declare this?" from
      ""Position.is~_teammate(contract.declarer)"" —
      the observation carries seats, never the
      declaring player or team.
      A future MCTS / learned level is a new
      strategy class, never an edit to AiPlayer.
    end note

    note bottom of HumanPlayer
      ""choose_bid"" / ""choose_card"" return
      **None** by design. Human input is
      serviced by **RichView** through the
      ""view.request_*_action"" hooks Round
      calls when ""player.is_human"".
    end note

}

' =========================================================
' model/game.py & model/round/ package — orchestration
' =========================================================
package "model/game.py" as p_game {
    class Game {
        + teams : list<Team>
        + players : list<Player>
        + players_by_position : dict<Position, Player>
        + deck : Deck
        + dealer : Player?
        + players_order : list<Player>
        + current_contract : Contract?
        + current_round : Round?
        + round_number : int
        + scores : dict<TeamSide, int>
        + rules : RuleConfig
        --
        + __init__(players: list<Player>, rules=None)
        + start_new_round() : None
        + manage_round(view=None) : None
        + check_game_over(target_score=1500) : GameOverStatus
        + next_dealer() : None
        + set_players_order() : None
    }

    class GameOverStatus <<frozen dataclass>> {
        + game_over : bool
        + winner : TeamSide?
        + tied_teams : list<TeamSide>?
        + final_scores : dict<TeamSide, int>
    }

    Game ..> GameOverStatus : <<check_game_over>>

    note bottom of Game
      Seating is enum-driven: the constructor
      requires exactly the four ""Position""
      members, sorts ""players"" into
      ""list(Position)"" order (the canonical
      anticlockwise seating), and indexes them
      once into ""players_by_position"" so team
      formation and any later seat lookup never
      re-scan the player list.
    end note

    note bottom of GameOverStatus
      Frozen verdict returned by
      ""Game.check_game_over(target)"".
      Over only when one team strictly
      leads at/above the target —
      ""winner"" is then always set.
      A tie at/above the target keeps
      ""game_over"" False and fills
      ""tied_teams"": sudden death,
      tiebreaker rounds until one team
      leads. ""cli.py"" loops on
      ""game_over"" and the end-game
      banner reads off the rest.
      Every team named here is a
      ""TeamSide"" — the same key
      ""final_scores"" uses, so a winner
      looks straight up in it.
    end note
}

package "model/round/ package" as p_round {
    ' --- round.py: the lifecycle orchestrator ---
    class Round {
        + players_order : list<Player>
        + dealer : Player
        + deck : Deck
        + round_number : int
        + contract : Contract?
        + auction : Auction?
        + play_state : PlayState?
        + round_score : RoundScore?
        + round_scores : dict<TeamSide, int> <<property>>
        + contract_made : bool? <<property>>
        + unannounced_slam : UnannouncedSlam? <<property>>
        + belote_pairs : dict<Player, tuple<Suit>>
        + belote_state : dict<(Player, Suit), str>
        + belote_order : list<(Player, Suit)>
        + belote_counts_by_side : dict<TeamSide, int> <<property>>
        + rules : RuleConfig
        --
        + __init__(players_order, dealer, deck, round_number, rules=None)
        + deal_cards() : None
        + manage_bidding(view=None) : Contract?
        + play_trick(view=None) : None
        + play_all_tricks(view=None) : None
        + calculate_round_scores() : dict<TeamSide, int>
        + handle_failed_contract() : dict<TeamSide, int>
        --
        - _gather_bid(player, auction, view) : Bid
        - _belote_suits() : tuple<Suit>
        - _detect_belote_pairs() : None
        - _is_belote_event(player, card) : bool
        - _transition_belote_state(player, suit) : str?
        - _scoring_belotes() : tuple<(Player, Suit)>
        - _sync_hands() : None
        - _trick_after_play() : Sequence<Play>
    }

    ' --- scoring.py: the pure scoring transformation ---
    class "scoring.py" as r_scoring <<module>> #FFEFD9 {
        score_round(round) : RoundScore
        sweep_substitute(tag) : int
        count_player_tricks(trick_winners, player) : int
        UnannouncedSlam <<enum>> : {SLAM, GRAND_SLAM}
    }

    class RoundScore <<dataclass>> #FFEFD9 {
        + scores : dict<TeamSide, int>
        + contract_made : bool?
        + unannounced_slam : UnannouncedSlam?
        + marks : dict<TeamSide, Mark>
        + belote_points : dict<TeamSide, int>
        + card_points : dict<TeamSide, int>
        + last_trick_side : TeamSide?
        + multiplier : int
    }

    ' --- components.py: the §7.2 arithmetic, over plain ints ---
    class "components.py" as p_components <<module>> #FFF8E1 {
        contract_components(...) : tuple<Mark, Mark>
        marked_total(mark, multiplier, rules) : int
        FLAT_FAILURE_PILE : int
    }

    class Mark <<frozen dataclass>> #FFF8E1 {
        + made : int
        + announced : int
    }

    Round ..> r_scoring : <<delegates scoring>>
    Round *-- "0..1" RoundScore : round_score
    r_scoring ..> p_components : <<delegates §7.2>>
    r_scoring ..> RoundScore : <<builds>>
    RoundScore "1" o-- "2" Mark : marks
    p_components ..> Mark : <<builds>>
    p_components ..> RuleConfig : <<reads §9.6>>

    note bottom of r_scoring
      **Belote is +20 //per pair//.** The scorer reads
      ""round.belote_counts_by_side"" and multiplies;
      how many pairs mark is the Round's call.
      A suit contract has one belote suit and so at
      most one pair, no trump has none, and all trump
      has four — where the table's ""all_trump_belote""
      regime picks //none// / //the first announced// /
      //every pair//, so a side can mark up to +80
      (contree-domain.md §6.6). The bonus survives
      every scoring shape, including the losing side's.
    end note

    note right of Round
      ""manage_bidding"" drives a core
      ""Auction.empty(rules=self.rules)"" through
      the cyclic ""players_order"" — the table
      ruleset is what decides the trump choices
      on offer and each mode's ladder top.
      Each turn: query
      ""legal_actions(player)""; if the only
      legal action is Pass (partner just
      doubled / redoubled), auto-apply it
      without prompting; otherwise gather a
      Bid from the player and the view.
      ""auction.apply"" raises
      ""IllegalBidError"" on an illegal bid —
      no silent force-Pass.
      ----
      The trick winner is read off
      ""play_state.trick_winners[-1]"" — ""apply""
      already adjudicated it, so there is no
      engine-side duplicate of the rule.
      ----
      The trick loop is driven by the immutable
      core ""contrai_core.play.PlayState"":
      ""play_all_tricks"" seeds it via
      ""PlayState.start"" (validated — 4 seats, 8
      distinct cards each); ""play_trick"" reads
      ""play_state.to_act"" /
      ""legal_actions(player)"" each turn and
      advances via
      ""play_state.apply(Play(player, card))"" —
      the sole legality-enforcing transition,
      raising ""IllegalPlayError"" on an
      out-of-turn, not-held, or obligation-
      breaking play (no silent fallback).
      ""_sync_hands"" then re-mirrors every seat's
      ""Hand"" from the new ""play_state"" so the
      view keeps reading ""player.hand"",
      while AI seats read the frozen
      ""PlayObservation"" projected by
      ""play_state.observe(player, bids=...)"".
      ""calculate_round_scores"" is a thin
      wrapper that publishes ""score_round""'s
      ""RoundScore"" onto ""round_score"";
      ""round_scores"" / ""contract_made"" /
      ""unannounced_slam"" are read-only
      properties over it, so they cannot drift.
      ----
      During play Round fires (each hasattr-guarded):
      * ""view.on_bid_made(player, bid, history)""
      * ""view.on_contract_established(self)""
        (once, immediately after the final
        Contract is built)
      * ""view.on_card_played(player, card, plays)""
      * ""view.on_belote_announced(player, kind, self)""
      * ""view.on_trick_complete(plays, winner, self)""
      ""Game.manage_round"" additionally fires
      ""view.on_round_dealt(round_)"" after the deal
      and ""view.on_all_pass_redeal()"" when
      everyone passes.
    end note

    note bottom of r_scoring
      Pure ""round -> RoundScore"" transform.
      Reads the **authoritative** ""round.play_state""
      — card points from each completed trick's
      pile credited to its winner's **side**
      (""winner.position.team_side"", never the
      mutable ""Team"" roster)
      (per-card values via ""rules_for(trump).points""),
      trick counts and the +10 last-trick bonus
      from ""trick_winners"" — never the
      view-facing mirrors.
      Its own job is only **reading the round**
      and **judging made/failed** — the arithmetic
      is ""components.py""'s. ""UnannouncedSlam"" tags an
      undeclared all-trick sweep on a numeric
      contract, and picks the flat substitute that
      stands in for its pile.
    end note

    note bottom of p_components
      **A mark is two components** (§7.2): the
      //made points// the trick pile is worth and
      the //announced points// the contract is
      worth. ""contract_components"" splits the
      round into one ""Mark"" per side;
      ""marked_total"" reduces a ""Mark"" to the
      number written down, applying the §7.3
      marking conventions and placing the
      double/redouble multiplier.
      ----
      Pure arithmetic over ints and a
      ""RuleConfig"" — no ""Round"", no ""Contract"",
      no ""PlayState"" — so the §7.2 grids are
      testable exactly as the domain reference
      prints them, and each §9.6 scoring row is
      one expression rather than a new branch.
    end note
}

' =========================================================
' view/ — live Rich terminal UI (split package)
' =========================================================
package "view/ package" as p_view {
    class RoundSummary <<dataclass>> {
        + round_number : int
        + contract : Contract?
        + contract_side : TeamSide?
        + contract_made : bool
        + ns_pts : int
        + ew_pts : int
        + running_ns : int
        + running_ew : int
    }

    class RichView {
        + {static} LOG_MAX : int = 5
        + console : rich.Console
        + target_score : int
        + history : list<RoundSummary>
        + last_completed_trick : (Sequence<Play>, BasePlayer)?
        + game : Game?
        + event_log : list<Text>
        --
        + attach(game, target_score) : None
        + reset_for_rematch() : None
        ..  engine hooks ..
        + request_bid_action(player, auction: Auction) : Bid
        + request_card_action(player, plays, contract, playable_cards) : Card
        + on_round_dealt(round_) : None
        + on_all_pass_redeal() : None
        + on_bid_made(player, bid, history) : None
        + on_contract_established(round_) : None
        + on_card_played(player, card, plays) : None
        + on_belote_announced(player, kind, round_) : None
        + on_trick_complete(plays, winner, round_) : None
        + on_round_complete(round_, running_scores) : None
        ..  CLI flow screens ..
        + show_landing(selected_target=1500) : int
        + show_round_recap(round_, running_scores, *, is_final=False) : None
        + show_end_game(status) : str <<'n' | 'r' | 'q'>>
        ..  orchestration seam + log helpers (private) ..
        - _render_in_game(*, phase, …) : None
        - _find_human_player() : BasePlayer?
        - _log(line: Text) : None
        - _format_bid_log(player, bid) : Text
        - _format_card_log(player, card) : Text
        - _format_trick_won_log(winner, points) : Text
    }

    class "view helpers\n(pure functions)" as p_view_helpers <<modules>> #FFEFD9 {
        theme.py
        formatting.py
        parsing.py
        bidding_rules.py
        state_helpers.py
        layout.py
    }

    class "view screens\n(pure (data)->Panel/Text)" as p_view_screens <<modules>> #FFEFD9 {
        screens/landing.py
        screens/bidding.py
        screens/trick.py
        screens/recap.py
        screens/endgame.py
    }

    note right of RichView
      Stateful orchestrator (in ""rich_view.py"").
      Six-screen UI: landing, bidding, mid-trick,
      trick-won, round-recap, end-game. Per-round
      summaries tracked here (""history"") so Game
      stays UI-free. A rolling 5-line ""event_log""
      is shown below the hand in every in-game
      state. Round / trick / recap panel titles
      use the #N format (e.g. Round #2,
      Last trick (#7), Current trick (#8)).
      ----
      Rendering is the pure-function modules' job.
      ""_render_in_game"" is the single seam that
      pulls state off ""self"" and feeds the screen
      builders; the hooks and input loops own all
      console I/O. Re-exported from
      ""view/~__init~__.py"" (so both
      ""view.RichView"" and
      ""view.rich_view.RichView"" resolve).
      ----
      AI pacing is tunable per-hook via the env
      vars ""CONTRAI_AI_BID_DELAY"" (1.4s) and
      ""CONTRAI_AI_CARD_DELAY"" (0.9s). The belote
      hook reuses the card delay.
    end note

    note bottom of p_view_helpers
      Stateless, self-free helpers, each in
      its own module:
      * theme — colour tokens + lookup tables
        (""POSITION_SHORT"" and friends are
        keyed by ""Position""; ""TRUMP_GLYPH"" /
        ""TRUMP_LABEL"" are keyed by
        ""ContractSuit"", giving the two suitless
        variants the tags ""NT"" / ""AT"" and the
        names //No Trump// / //All Trump//)
      * formatting — seat / suit / contract /
        trump labels + the compact ""_bid_label""
      * parsing — ""_parse_bid_input"",
        ""_parse_card_input""
      * bidding_rules — ""_illegal_bid_reason""
        (the prompt hint reads
        ""Auction.legal_actions"" directly; the
        table-limit branches read
        ""bookable_suits"" / ""ladder_top"" rather
        than restating the numbers)
      * state_helpers — ""_current_winner"",
        ""_trick_index"" (which of the eight
        tricks is on the table),
        ""_explain_constraint"",
        ""_sort_hand_for_display"",
        ""_belote_by_position"", ""_resolve_delay""
      * layout — ""_two_column"", ""_panel_prompt"",
        ""_panel_event_log"", ""_panel_game_score""
        (the top-left panel of every in-game
        frame)
    end note

    note bottom of p_view_screens
      Pure (data) -> Panel/Text builders — no
      state, no I/O. RichView composes + prints
      them; screens reuse the helpers above.
      Seat-indexed layouts (the bidding and trick
      diamonds, the landing roster) key off
      ""Position"" members rather than seat
      strings.
      The round-recap breakdown credits each
      team: contract bonus (attacker base on
      normal made, 160+base×mult on doubled
      made, (160+base)×mult on failed defender)
      + card points + last-trick bonus + belote
      → ""round_scores[side]"". The card /
      last-trick / belote rows
      em-dash when the engine ignores them so
      the addition matches ""round_score"".
      Helpers ""_recap_breakdown"" /
      ""_format_recap_table"" /
      ""_belote_counts_in_round"" live in
      ""screens/recap.py"".
      ----
      Tested per-module in
      ""tests/test_view/test_*.py""; the deepest
      layouts are validated by ""uv run contrai"".
    end note
}

' =========================================================
' cli.py — the "contrai" console-script entry point
' =========================================================
package "cli.py" as p_cli {
    class "main()" as Cli <<module>> #FFEFD9 {
        + main() : None
        --
        - _build_parser() : ArgumentParser
        - _parse_args(argv) : (DebugOptions, RuleConfig)
        - _build_game(autoplay, rules) : Game
        --
        Drives landing → game loop →
        end-game; routes 'n' / 'r' / 'q'.
    }

    note right of Cli
      Hardcoded seating:
      ""HUMAN_SEAT = Position.SOUTH""
      is the ""HumanPlayer"";
      the loop over ""Position"" fills the other
      three seats with ""AiPlayer"" (expert —
      the AiPlayer default).
      TODO marker for a future seat
      picker on the landing screen.
      ""--rules FILE"" / ""--preset NAME"" are a
      mutually exclusive pair; whichever is given
      resolves to the ""RuleConfig"" the ""Game""
      is built under. A bad ruleset leaves through
      ""parser.error"" — usage + message, exit 2.
    end note
}

' =========================================================
' ruleset.py — TOML ⇄ RuleConfig, engine-side
' =========================================================
package "ruleset.py" as p_ruleset {
    class "ruleset.py" as Ruleset <<module>> #FFEFD9 {
        SECTIONS : dict<str, tuple<str>>
        --
        parse_ruleset(text) : RuleConfig
        load_ruleset(path) : RuleConfig
        dump_ruleset(config) : str
        resolve_rules(*, preset, rules_path) : RuleConfig
        --
        - _coerce(section, key, value) : Any
        - _format(value) : str
    }

    class RulesetError <<ValueError>>

    Ruleset ..> RulesetError : <<raises>>

    note bottom of Ruleset
      **Loading lives in the engine** — core stays
      I/O-free, so it defines what a ruleset //is//
      and this module decides how one is //read//.
      ""SECTIONS"" is the six-section §9 layout, one
      entry per catalogue subsection; a test asserts
      it covers every ""RuleConfig"" field exactly once.
      **Unknown = error**, never a warning: an unknown
      section or key, a wrong type or an unknown enum
      token all raise ""RulesetError"", because a
      typo'd knob that silently kept its default would
      corrupt a logged experiment. A //missing// key is
      fine — a file is a partial override on the
      defaults. A well-formed but impossible table
      propagates core's ""InvalidRuleConfigError"".
      ""dump_ruleset"" is the exact inverse, so a
      resolved ruleset can be archived beside a
      simulation result or a scraped game.
    end note
}

' =========================================================
' Relationships
' =========================================================

' Player hierarchy
BasePlayer <|-- Player
Player <|-- HumanPlayer
Player <|-- AiPlayer
BasePlayer --> Position : position

' Pluggable AI strategies (injected into AiPlayer)
BiddingStrategy <|-- RuleBasedBiddingStrategy
CardPlayStrategy <|-- RuleBasedCardPlayStrategy
PlayerStateMixin <|-- RuleBasedBiddingStrategy
PlayerStateMixin <|-- RuleBasedCardPlayStrategy

' Both strategies speak core's two suit types: the bidding table searches
' the four card suits, the card-play rules ask core's trump predicate
' rather than comparing a card suit against a contract's trump by hand.
RuleBasedBiddingStrategy --> Suit            : SUIT_PREFERENCE
RuleBasedCardPlayStrategy ..> p_contractsuit : is_trump / trump_suits
PlayerStateMixin ..> AiPlayer : <<reads live state>>
AiPlayer o-- "1" BiddingStrategy : bidding
AiPlayer o-- "1" CardPlayStrategy : cardplay
p_levels ..> AiPlayer : <<builds>>

' Game composes / aggregates engine + core types
Game "1" *-- "2" Team : teams
Game "1" *-- "4" Player : players
Game "1" *-- "1" Deck : deck
Game "1" o-- "0..1" Player : dealer
Game "1" *-- "0..1" Round : current_round
Game "1" o-- "0..1" Contract : current_contract

' The table ruleset is fixed when the table sits down: Game holds it and
' hands the same object to every Round, which runs its auction under it
' and seeds it into the play state. The scorer reads it back off the
' Round rather than being handed one, so no two phases of a round can
' run under different rulesets.
Game "1" o-- "1" RuleConfig : rules

' Round references Contract / Auction / PlayState — the play phase
' itself lives entirely on play_state, so no Tricks are held here.
Round "1" o-- "0..1" Contract : contract
Round "1" o-- "0..1" Auction : auction
Round "1" o-- "0..1" PlayState : play_state
Round "1" o-- "1" Deck : deck
Round "1" o-- "4" Player : players_order
Round "1" o-- "1" RuleConfig : rules

' View + CLI wiring (the controller role today = cli.py loop + view hooks)
Round ..> RichView : <<human input + hooks>>
Cli ..> Game : <<owns game loop>>
Cli ..> RichView : <<owns view + screens>>
Cli ..> Ruleset : <<--rules / --preset>>
Ruleset ..> RuleConfig : <<builds / validates>>
RichView "1" *-- "0..N" RoundSummary : history
RichView ..> p_view_screens : <<composes + prints>>
RichView ..> p_view_helpers : <<uses>>
p_view_screens ..> p_view_helpers : <<uses>>

@enduml
